# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rubicsrealty.com

# Enquiry delivery. In production at least one must be configured, or the form returns an error
# (leads are never silently dropped).
# Option A: email via Resend (https://resend.com). ENQUIRY_TO accepts a comma-separated list.
RESEND_API_KEY=
ENQUIRY_TO=sales@rubics.co
ENQUIRY_FROM="Rubics Realty website <website@rubicsrealty.com>"

# Option B: POST each lead as JSON to the client's CRM (sent with X-Webhook-Secret if set).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
